---
import Layout from '../layouts/Layout.astro';
import { db, Purchase, User } from 'astro:db';
import { eq } from 'astro:db';
import { Resend } from 'resend';
import fs from 'fs';
import path from 'path'; 

const resend = new Resend(import.meta.env.RESEND_API_KEY);

const sessionCookie = Astro.cookies.get('session');
const session = sessionCookie ? JSON.parse(sessionCookie.value) : null;

const paymentId = Astro.url.searchParams.get('payment_id');
const status = Astro.url.searchParams.get('status');
const planId = Astro.url.searchParams.get('external_reference');

if (status === 'approved' && session && paymentId) {
  try {
    // Asegurarse que el usuario existe en la DB
    const existingUser = await db.select().from(User).where(eq(User.id, String(session.id))).get();

    if (!existingUser) {
      await db.insert(User).values({
        id: String(session.id),
        name: String(session.name),
        email: String(session.email),
        image: String(session.image)  || '',
        createdAt: new Date(),
      });
      console.log('Usuario creado en DB:', session.email);
    }

    // Guardar la compra
    await db.insert(Purchase).values({
      id: paymentId,
      userId: String(session.id),
      planId: planId || 'unknown',
      planName: planId === 'plan-basico' ? 'Rutina Base' : 'Planificación Mensual Personalizada',
      price: planId === 'plan-basico' ? 10000 : 60000,
      status: 'approved',
      mpPaymentId: paymentId,
      createdAt: new Date(),
    });
    console.log('Compra guardada en DB:', paymentId);

    // Preparar adjunto según el plan
    const attachments = [];
    if (planId === 'plan-basico') {
      const filePath = path.join(process.cwd(), 'public/planes/rutina-base.csv');
      const fileContent = fs.readFileSync(filePath);
      attachments.push({
        filename: 'Rutina-Base.csv',
        content: fileContent,
      });
    }

    // Enviar correo
    await resend.emails.send({
      from: 'onboarding@resend.dev',
      to: session.email,
      subject: '¡Tu compra fue exitosa! 💪',
      attachments,
      html: `
        <h1>¡Hola ${session.name}!</h1>
        <p>Tu compra fue procesada correctamente.</p>
        <h2>Detalles de tu compra:</h2>
        <ul>
          <li><strong>Plan:</strong> ${planId === 'plan-basico' ? 'Rutina Base' : 'Planificación Mensual Personalizada'}</li>
          <li><strong>Precio:</strong> $${planId === 'plan-basico' ? '10.000' : '60.000'} CLP</li>
          <li><strong>ID de pago:</strong> ${paymentId}</li>
        </ul>
        ${planId === 'plan-basico' 
          ? '<p>Adjunto encontrarás tu rutina de entrenamiento.</p>' 
          : '<p>En las próximas 24 horas me pondré en contacto contigo para comenzar tu planificación personalizada.</p>'
        }
        <p>¡Mucho éxito en tu entrenamiento! 💪</p>
      `,
    });
    console.log('Correo enviado a:', session.email);

  } catch (error) {
    console.error('Error:', error);
  }
}
---

<Layout title="Pago Exitoso">
  <div class="result-page">
    <div class="container">
      <div class="result-card success">
        <div class="icon">✅</div>
        <h1>¡Pago Exitoso!</h1>
        <p>Tu compra se ha procesado correctamente.</p>
        <p class="info">
          Recibirás tu plan de entrenamiento por correo electrónico en las próximas 24 horas.
        </p>
        <a href="/" class="btn btn-primary">Volver al Inicio</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .result-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: 2rem 0;
  }

  .result-card {
    text-align: center;
    background: white;
    padding: 3rem 2rem;
    border-radius: 16px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    max-width: 500px;
    margin: 0 auto;
  }

  .icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  h1 {
    color: var(--color-secondary);
    margin-bottom: 1rem;
    font-size: 2rem;
  }

  p {
    color: #666;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .info {
    background: var(--color-bg-alt);
    padding: 1rem;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .btn {
    margin-top: 1.5rem;
  }
</style>